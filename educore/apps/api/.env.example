# ─────────────────────────────────────────────────────────────────────────────
# EduCore API - Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=3001
API_VERSION=1
API_PREFIX=api

# Frontend
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/educore"
# Production example:
# DATABASE_URL="postgresql://user:password@your-db-host:5432/educore?sslmode=require"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_URL=redis://:password@localhost:6379  # alternative

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-this-to-a-very-long-random-string-minimum-32-chars
JWT_REFRESH_SECRET=change-this-to-another-very-long-random-string-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MFA
MFA_APP_NAME=EduCore
MFA_ENABLED=true

# ─── Email ────────────────────────────────────────────────────────────────────
# SMTP (works with Gmail, Outlook, custom)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@yourschool.com
MAIL_PASSWORD=your-app-password
MAIL_FROM="EduCore <noreply@yourschool.com>"

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Mailgun (alternative)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# ─── File Storage ─────────────────────────────────────────────────────────────
# Cloudinary (recommended for images and documents)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (alternative or for large files)
AWS_S3_BUCKET=educore-files
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_ENDPOINT=  # For DigitalOcean Spaces, Wasabi, etc.

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# ─── Payment Gateways ─────────────────────────────────────────────────────────
# All gateways are configured from the admin dashboard.
# These env vars are fallbacks; dashboard config takes priority.

PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxx

FLUTTERWAVE_SECRET_KEY=FLWSECK_LIVE-xxxxxxxxxxxxxxxxxx
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_LIVE-xxxxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx

MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── SMS Providers ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

TERMII_API_KEY=
TERMII_SENDER_ID=EduCore

# ─── Third-Party Integrations ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=200
ENCRYPTION_KEY=32-char-encryption-key-for-sensitive-data

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: error | warn | info | debug | verbose

# ─── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_SWAGGER=true
ENABLE_RATE_LIMITING=true
ENABLE_COMPRESSION=true
ENABLE_AUDIT_LOGGING=true

# ─── Backup ───────────────────────────────────────────────────────────────────
BACKUP_STORAGE=local
# Options: local | s3 | cloudinary
BACKUP_RETENTION_DAYS=30

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_BACKUP_SCHEDULE="0 2 * * *"        # Daily at 2am
CRON_ATTENDANCE_REMINDER="0 9 * * 1-5"  # Weekdays at 9am
CRON_FEE_REMINDER="0 8 * * *"           # Daily at 8am
CRON_REPORT_GENERATION="0 6 * * 0"      # Weekly on Sunday
