# ─────────────────────────────────────────────────────────────────────────────
# EduCore Web - Environment Configuration
# Copy this file to .env.local for development
# ─────────────────────────────────────────────────────────────────────────────

# API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# WebSocket URL for real-time features
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# App metadata
NEXT_PUBLIC_APP_NAME=EduCore
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=3.0.0

# File upload limits
NEXT_PUBLIC_MAX_FILE_SIZE_MB=50

# Cloudinary (for direct browser uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=educore_unsigned

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxx@sentry.io/xxxxxxx

# Feature toggles
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CHAT=true
NEXT_PUBLIC_ENABLE_PARENT_PORTAL=true
