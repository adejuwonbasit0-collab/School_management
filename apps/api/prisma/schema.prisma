  schoolId    String
  name        String
  type        String   @default("PERCENTAGE")
  value       Decimal  @db.Decimal(12, 2)
  applicableTo String[] // fee structure IDs
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  @@index([schoolId])
}

model FinancialAuditLog {
  id          String   @id @default(cuid())
  schoolId    String
  entity      String
  entityId    String
  action      String
  amount      Decimal? @db.Decimal(12, 2)
  performedBy String
  notes       String?
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([schoolId, entity])
}

// ── Library Extensions ───────────────────────────────────────

model BookReservation {
  id          String   @id @default(cuid())
  bookId      String
  studentId   String
  reservedAt  DateTime @default(now())
  expiresAt   DateTime
  status      String   @default("ACTIVE")
  @@index([bookId])
}

// ── HR Extensions ────────────────────────────────────────────

model SalaryStructure {
  id           String   @id @default(cuid())
  schoolId     String
  name         String
  basicSalary  Decimal  @db.Decimal(12, 2)
  allowances   Json     // { housing: %, transport: %, medical: % }
  deductions   Json     // { tax: %, pension: % }
