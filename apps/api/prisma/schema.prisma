  isDefault    Boolean  @default(false)
  staff        Staff[]  @relation("SalaryStructureStaff")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@index([schoolId])
}

model PerformanceReview {
  id          String   @id @default(cuid())
  staffId     String
  reviewedBy  String
  period      String
  scores      Json     // { punctuality, teamwork, performance, ... }
  totalScore  Decimal  @db.Decimal(5, 2)
  grade       String?
  comments    String?
  createdAt   DateTime @default(now())
  @@index([staffId])
}

model DisciplinaryRecord {
  id          String   @id @default(cuid())
  staffId     String
  type        String
  description String
  action      String
  date        DateTime @default(now())
  recordedBy  String
  resolved    Boolean  @default(false)
  @@index([staffId])
}

// ── Customization / Theming ──────────────────────────────────

model SchoolTheme {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  primaryColor   String   @default("#1a56db")
  secondaryColor String   @default("#7c3aed")
  accentColor    String   @default("#059669")
  fontFamily     String   @default("Inter")
  logoUrl        String?
  faviconUrl     String?
  loginBgUrl     String?
  customCss      String?
  footerText     String?
  updatedAt      DateTime @updatedAt
}

model CustomPage {
  id        String   @id @default(cuid())
  schoolId  String
  slug      String
  title     String
  type      String   @default("PAGE") // PAGE | COURSE | BLOG | LANDING
  content   Json
  isPublished Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([schoolId, slug])
  @@index([schoolId, type])
}

// ── Hostel Extensions ────────────────────────────────────────

model HostelAllocation {
  id          String     @id @default(cuid())
  studentId   String
  hostelId    String
  roomId      String?
  room        HostelRoom? @relation(fields: [roomId], references: [id])
  bedNumber   Int?
  startDate   DateTime
  endDate     DateTime?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  @@index([studentId])
}

// ── Transport Extensions ─────────────────────────────────────

model TransportPickup {
  id        String         @id @default(cuid())
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  name      String
  time      String
  sequence  Int
  landmark  String?
}

model TransportAssignment {
  id        String         @id @default(cuid())
  studentId String
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id])
  pickupPointId String?
  startDate DateTime
  endDate   DateTime?
  status    String         @default("ACTIVE")
  @@index([studentId])
}

// ── Backup Records ───────────────────────────────────────────

model BackupRecord {
  id          String   @id @default(cuid())
  schoolId    String
  type        String   // FULL | INCREMENTAL
  status      String   @default("PENDING")
  size        BigInt?
  location    String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  triggeredBy String
  notes       String?
  @@index([schoolId])
}
